#!/usr/bin/env python3
"""Select a Git worktree to enter or remove."""

import os
import shlex
import subprocess
import sys


def worktrees():
    result = subprocess.run(
        ["git", "worktree", "list", "--porcelain", "-z"],
        stdout=subprocess.PIPE,
        check=True,
    )
    entries = []
    for field in result.stdout.split(b"\0"):
        if field.startswith(b"worktree "):
            entries.append({"path": os.fsdecode(field[len(b"worktree "):]), "branch": ""})
        elif field.startswith(b"branch "):
            entries[-1]["branch"] = os.fsdecode(field[len(b"branch "):]).removeprefix("refs/heads/")
        elif field == b"detached":
            entries[-1]["branch"] = "detached"
    return entries


def preview_command(option):
    return " ".join((
        shlex.quote(sys.executable),
        shlex.quote(os.path.abspath(__file__)),
        option, "{1}",
    ))


def choose(entries):
    rows = []
    for index, entry in enumerate(entries):
        path = entry["path"].replace("\n", "\\n").replace("\t", "\\t")
        branch = entry["branch"].replace("\n", "\\n").replace("\t", "\\t")
        rows.append(f"{index}\t{path}\t{branch}".encode())
    result = subprocess.run(
        ["fzf", "--read0", "--print0", "--multi", "--expect=x",
         "--delimiter=\t", "--with-nth=2..",
         "--preview=" + preview_command("--preview"),
         "--bind=ctrl-s:preview(" + preview_command("--status-preview") + ")",
         "--header=Tab: mark  |  Enter: cd  |  x: remove marked  |  Ctrl-S: check changes"],
        input=b"\0".join(rows) + b"\0",
        stdout=subprocess.PIPE,
    )
    if result.returncode:
        return None
    key, *rows = result.stdout.rstrip(b"\0").split(b"\0")
    return key, [entries[int(row.split(b"\t", 1)[0])] for row in rows]


def base_branch(path):
    for branch in ("main", "master"):
        if subprocess.run(
            ["git", "-C", path, "show-ref", "--verify", "--quiet",
             f"refs/heads/{branch}"],
        ).returncode == 0:
            return branch
    return None


def ahead_behind(path, branch):
    counts = subprocess.run(
        ["git", "-C", path, "rev-list", "--left-right", "--count",
         f"refs/heads/{branch}...HEAD"],
        capture_output=True, check=True, text=True,
    ).stdout.split()
    behind, ahead = map(int, counts)
    return ahead, behind


def has_changes(path):
    status = subprocess.run(
        ["git", "-C", path, "status", "--porcelain=v1", "-z",
         "--untracked-files=normal"],
        stdout=subprocess.PIPE, check=True,
    )
    return bool(status.stdout)


def preview(entry, check_changes=False):
    path = entry["path"]
    print(f"Worktree: {path}")
    print(f"Branch:   {entry['branch'] or 'unknown'}")
    branch = base_branch(path)
    if branch:
        ahead, behind = ahead_behind(path, branch)
        print(f"Against {branch}: {ahead} ahead, {behind} behind")
        print(f"Contained in {branch}: {'yes' if ahead == 0 else 'no'}")
    else:
        print("Base branch: no local main or master")
    sys.stdout.flush()
    if check_changes:
        print(f"Changes: {'dirty' if has_changes(path) else 'clean'}")
    else:
        print("Changes: press Ctrl-S to check")


def confirm_removal(paths):
    with open("/dev/tty", "w", encoding="utf-8") as prompt:
        with open("/dev/tty", "r", encoding="utf-8") as response:
            if len(paths) == 1:
                prompt.write(f"Remove worktree {paths[0]}? [y/N] ")
            else:
                prompt.write(f"Remove {len(paths)} worktrees?\n")
                for path in paths:
                    prompt.write(f"  {path}\n")
                prompt.write("[y/N] ")
            prompt.flush()
            return response.readline().strip().lower() in ("y", "yes")


def remove_worktrees(entries):
    paths = [entry["path"] for entry in entries]
    current = os.getcwd()
    removable = [path for path in paths if os.path.commonpath((current, path)) != path]
    if len(removable) != len(paths):
        print("Cannot remove the current worktree; switch away first.", file=sys.stderr)
    if not removable:
        return 1
    if not confirm_removal(removable):
        return 0
    failed = len(removable) != len(paths)
    for path in removable:
        if subprocess.run(["git", "worktree", "remove", path], stdout=sys.stderr).returncode:
            failed = True
    return int(failed)


def main():
    preview_mode = len(sys.argv) == 3 and sys.argv[1] in ("--preview", "--status-preview")
    if len(sys.argv) != 1 and not preview_mode:
        print("usage: git wt", file=sys.stderr)
        return 2
    try:
        if len(sys.argv) == 3:
            preview(worktrees()[int(sys.argv[2])], sys.argv[1] == "--status-preview")
            return 0
        entries = worktrees()
        selection = choose(entries)
        if selection is None:
            return 0
        key, selected = selection
        if key == b"x":
            return remove_worktrees(selected)
        if len(selected) != 1:
            print("Select one worktree to enter, or press x to remove the marked worktrees.", file=sys.stderr)
            return 1
        print(selected[0]["path"])
        return 0
    except (IndexError, ValueError):
        print("git wt: worktree selection is no longer available", file=sys.stderr)
        return 1
    except (OSError, subprocess.CalledProcessError) as error:
        print(f"git wt: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
