#!/usr/bin/env python3
"""Select a Git worktree to enter or remove."""

import base64
import concurrent.futures
import json
import os
import pathlib
import shlex
import subprocess
import sys

DEFAULT_ROOTS = "~/src"
# ~/src/<host>/<org>/<repo> sits three levels down; one more allows for
# slightly deeper layouts without walking into large source trees.
MAX_SCAN_DEPTH = 4
STATUS_APP = "git-wt"


def worktrees(repo="."):
    result = subprocess.run(
        ["git", "-C", repo, "worktree", "list", "--porcelain", "-z"],
        stdout=subprocess.PIPE,
        check=True,
    )
    entries = []
    for field in result.stdout.split(b"\0"):
        if field.startswith(b"worktree "):
            entries.append({"path": os.fsdecode(field[len(b"worktree "):]), "branch": ""})
        elif field.startswith(b"branch "):
            entries[-1]["branch"] = os.fsdecode(field[len(b"branch "):]).removeprefix("refs/heads/")
        elif field == b"detached":
            entries[-1]["branch"] = "detached"
    return entries


def repository_roots():
    configured = os.environ.get("GIT_WT_ROOTS", DEFAULT_ROOTS)
    return [os.path.expanduser(root) for root in configured.split(os.pathsep) if root]


def find_repositories(directory, depth=MAX_SCAN_DEPTH):
    """Yield main checkouts under directory without descending into any checkout."""
    try:
        children = list(os.scandir(directory))
    except OSError:
        return
    git = next((child for child in children if child.name == ".git"), None)
    if git is not None:
        if git.is_dir(follow_symlinks=False):
            yield directory
        return
    if depth == 0:
        return
    for child in children:
        if child.is_dir(follow_symlinks=False) and not child.name.startswith("."):
            yield from find_repositories(child.path, depth - 1)


def repository_names(repositories):
    """Name each repository by the shortest trailing path no other shares."""
    parts = {repo: pathlib.PurePath(repo).parts for repo in repositories}
    names = {}
    for repo, own in parts.items():
        others = [other for other_repo, other in parts.items() if other_repo != repo]
        length = 1
        while length < len(own) and any(other[-length:] == own[-length:] for other in others):
            length += 1
        names[repo] = "/".join(own[-length:])
    return names


def repository_worktrees(repo, name=None):
    """List a repository's worktrees, named after the main checkout unless name is given."""
    try:
        entries = worktrees(repo)
    except subprocess.CalledProcessError as error:
        print(f"git wt: skipping {repo}: {error}", file=sys.stderr)
        return []
    name = name or os.path.basename(entries[0]["path"])
    # Git lists the main checkout first; keep it there and order the rest by branch.
    main = [{**entry, "main": True} for entry in entries[:1]]
    linked = sorted(entries[1:], key=lambda entry: entry["branch"].casefold())
    return [{**entry, "repo": name} for entry in main + linked if os.path.isdir(entry["path"])]


def usage_scores():
    """Map each directory zoxide knows to its frecency score; empty without zoxide."""
    try:
        listed = subprocess.run(["zoxide", "query", "--list", "--score"],
                                capture_output=True, text=True)
    except FileNotFoundError:
        return {}
    scores = {}
    for line in listed.stdout.splitlines():
        score, _, path = line.strip().partition(" ")
        scores[path] = float(score)
    return scores


def repository_usage(repo, scores):
    inside = repo + os.sep
    return sum(score for path, score in scores.items() if path == repo or path.startswith(inside))


def all_worktrees(roots):
    """List worktrees of every repository, most used repositories first, then by name."""
    repositories = [repo for root in roots for repo in find_repositories(root)]
    names = repository_names(repositories)
    scores = usage_scores()
    repositories.sort(key=lambda repo: (-repository_usage(repo, scores), names[repo].casefold()))
    with concurrent.futures.ThreadPoolExecutor() as pool:
        listings = pool.map(repository_worktrees, repositories, map(names.get, repositories))
    return [entry for listing in listings for entry in listing]


def upstream_gone(path, branch):
    track = subprocess.run(
        ["git", "-C", path, "for-each-ref", "--format=%(upstream:track)",
         f"refs/heads/{branch}"],
        capture_output=True, check=True, text=True,
    ).stdout.strip()
    return track == "[gone]"


def stale_reason(entry):
    path = entry["path"]
    base = base_branch(path)
    if base and ahead_behind(path, base)[0] == 0:
        return f"merged into {base}"
    if entry["branch"] != "detached" and upstream_gone(path, entry["branch"]):
        return "upstream gone"
    return None


def stale_entry(entry):
    """Return entry with why it is stale and whether it is dirty, or None if it is in use."""
    try:
        reason = stale_reason(entry)
        return reason and {**entry, "reason": reason, "dirty": has_changes(entry["path"])}
    except subprocess.CalledProcessError as error:
        print(f"git wt: skipping {entry['path']}: {error}", file=sys.stderr)
        return None


def stale_worktrees(entries):
    """Pick the linked worktrees whose work is merged into the base branch or whose upstream is gone."""
    linked = [entry for entry in entries if not entry.get("main")]
    with concurrent.futures.ThreadPoolExecutor() as pool:
        return [entry for entry in pool.map(stale_entry, linked) if entry]


def report_status(state, message=None, **pairs):
    """Tell a terminal that speaks OSC 7501 what git-wt is doing; others ignore it.

    It goes to stderr because the shell function reads stdout as a directory.
    """
    if not sys.stderr.isatty():
        return
    fields = [f"state={state}", f"app={STATUS_APP}"]
    fields += [f"{key}={value}" for key, value in pairs.items()]
    if message:
        fields.append("msg=" + base64.b64encode(message.encode()).decode())
    sys.stderr.write("\033]7501;" + ":".join(fields) + "\033\\")
    sys.stderr.flush()


def run_fzf(columns, options):
    """Show one row of columns per entry; return the rows fzf printed, or None if cancelled."""
    rows = []
    for index, fields in enumerate(columns):
        escaped = (field.replace("\n", "\\n").replace("\t", "\\t") for field in fields)
        rows.append("\t".join((str(index), *escaped)).encode())
    result = subprocess.run(
        ["fzf", "--read0", "--print0", "--multi", "--delimiter=\t", "--with-nth=2..", *options],
        input=b"\0".join(rows) + b"\0",
        stdout=subprocess.PIPE,
    )
    if result.returncode:
        return None
    return result.stdout.rstrip(b"\0").split(b"\0")


def selected_entries(entries, rows):
    return [entries[int(row.split(b"\t", 1)[0])] for row in rows if row]


def preview_command(option):
    return " ".join((
        shlex.quote(sys.executable),
        shlex.quote(os.path.abspath(__file__)),
        option, "{1}",
    ))


def choose(entries):
    output = run_fzf(
        [(entry["path"], entry["branch"]) for entry in entries],
        ["--expect=x",
         "--preview=" + preview_command("--preview"),
         "--bind=ctrl-s:preview(" + preview_command("--status-preview") + ")",
         "--header=Tab: mark  |  Enter: cd  |  x: remove marked  |  Ctrl-S: check changes"],
    )
    if output is None:
        return None
    key, *rows = output
    return key, selected_entries(entries, rows)


def choose_stale(entries):
    output = run_fzf(
        [(f"{entry['repo']}:{entry['branch']}", entry["reason"], entry["path"]) for entry in entries],
        ["--bind=load:select-all",
         "--header=All marked  |  Tab: unmark  |  Enter: remove marked  |  Esc: cancel"],
    )
    return selected_entries(entries, output) if output else []


def base_branch(path):
    for branch in ("main", "master"):
        if subprocess.run(
            ["git", "-C", path, "show-ref", "--verify", "--quiet",
             f"refs/heads/{branch}"],
        ).returncode == 0:
            return branch
    return None


def ahead_behind(path, branch):
    counts = subprocess.run(
        ["git", "-C", path, "rev-list", "--left-right", "--count",
         f"refs/heads/{branch}...HEAD"],
        capture_output=True, check=True, text=True,
    ).stdout.split()
    behind, ahead = map(int, counts)
    return ahead, behind


def has_changes(path):
    status = subprocess.run(
        ["git", "-C", path, "status", "--porcelain=v1", "-z",
         "--untracked-files=normal"],
        stdout=subprocess.PIPE, check=True,
    )
    return bool(status.stdout)


def preview(entry, check_changes=False):
    path = entry["path"]
    print(f"Worktree: {path}")
    print(f"Branch:   {entry['branch'] or 'unknown'}")
    branch = base_branch(path)
    if branch:
        ahead, behind = ahead_behind(path, branch)
        print(f"Against {branch}: {ahead} ahead, {behind} behind")
        print(f"Contained in {branch}: {'yes' if ahead == 0 else 'no'}")
    else:
        print("Base branch: no local main or master")
    sys.stdout.flush()
    if check_changes:
        print(f"Changes: {'dirty' if has_changes(path) else 'clean'}")
    else:
        print("Changes: press Ctrl-S to check")


def confirm_removal(paths):
    with open("/dev/tty", "w", encoding="utf-8") as prompt:
        with open("/dev/tty", "r", encoding="utf-8") as response:
            if len(paths) == 1:
                prompt.write(f"Remove worktree {paths[0]}? [y/N] ")
            else:
                prompt.write(f"Remove {len(paths)} worktrees?\n")
                for path in paths:
                    prompt.write(f"  {path}\n")
                prompt.write("[y/N] ")
            prompt.flush()
            return response.readline().strip().lower() in ("y", "yes")


def remove_worktrees(entries):
    paths = [entry["path"] for entry in entries]
    current = os.getcwd()
    removable = [path for path in paths if os.path.commonpath((current, path)) != path]
    if len(removable) != len(paths):
        print("Cannot remove the current worktree; switch away first.", file=sys.stderr)
    if not removable:
        return 1
    report_status("blocked", f"Confirm removing {len(removable)} worktrees", kind="permission")
    if not confirm_removal(removable):
        report_status("idle")
        return 0
    failures = remove_each(removable) + len(paths) - len(removable)
    return int(failures > 0)


def remove_each(paths):
    """Remove each worktree, reporting progress; return how many git refused."""
    failures = 0
    for done, path in enumerate(paths):
        report_status("working", f"Removing {path}", progress=done * 100 // len(paths))
        # -C lets this run from outside the repository, as the Rex panel does.
        if subprocess.run(["git", "-C", path, "worktree", "remove", path],
                          stdout=sys.stderr).returncode:
            failures += 1
        else:
            print(f"Removed {path}", file=sys.stderr)
    summary = f"Removed {len(paths) - failures} of {len(paths)} worktrees"
    print(summary, file=sys.stderr)
    report_status("error" if failures else "done", summary)
    return failures


def clean(list_worktrees):
    """Offer the stale worktrees from list_worktrees() for removal, all marked."""
    print("Finding stale worktrees…", file=sys.stderr)
    report_status("working", "Finding stale worktrees")
    stale = stale_worktrees(list_worktrees())
    for entry in stale:
        if entry["dirty"]:
            print(f"Keeping {entry['path']}: it has uncommitted changes", file=sys.stderr)
    removable = [entry for entry in stale if not entry["dirty"]]
    if not removable:
        print("No stale worktrees to remove.", file=sys.stderr)
        report_status("done", "No stale worktrees to remove")
        return 0
    report_status("blocked", "Choose worktrees to remove", kind="question")
    chosen = choose_stale(removable)
    if not chosen:
        report_status("idle")
        return 0
    return remove_worktrees(chosen)


def pick():
    entries = worktrees()
    selection = choose(entries)
    if selection is None:
        return 0
    key, selected = selection
    if key == b"x":
        return remove_worktrees(selected)
    if len(selected) != 1:
        print("Select one worktree to enter, or press x to remove the marked worktrees.", file=sys.stderr)
        return 1
    print(selected[0]["path"])
    return 0


USAGE = "usage: git wt [--clean | --clean-all | --list-all | --list-stale]"
LISTINGS = {
    "--list-all": all_worktrees,
    "--list-stale": lambda roots: stale_worktrees(all_worktrees(roots)),
}
CLEANUPS = {
    "--clean": lambda: repository_worktrees("."),
    "--clean-all": lambda: all_worktrees(repository_roots()),
}


def run_command(args):
    if len(args) == 1 and args[0] in LISTINGS:
        json.dump(LISTINGS[args[0]](repository_roots()), sys.stdout)
        return 0
    if len(args) == 1 and args[0] in CLEANUPS:
        return clean(CLEANUPS[args[0]])
    if len(args) == 2 and args[0] in ("--preview", "--status-preview"):
        preview(worktrees()[int(args[1])], args[0] == "--status-preview")
        return 0
    if args:
        print(USAGE, file=sys.stderr)
        return 2
    return pick()


def main():
    try:
        return run_command(sys.argv[1:])
    except (IndexError, ValueError):
        print("git wt: worktree selection is no longer available", file=sys.stderr)
        return 1
    except (OSError, subprocess.CalledProcessError) as error:
        print(f"git wt: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
